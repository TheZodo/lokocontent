# =============================================================================
# Lokocontent Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# Never commit .env to version control!

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Local development: postgresql://user:password@localhost:5432/lokocontent
# Production: Use your cloud provider's connection string
DATABASE_URL="postgresql://user:password@localhost:5432/lokocontent?schema=public"

# =============================================================================
# Clerk Authentication
# =============================================================================
# Get these from: https://dashboard.clerk.com/ > Your App > API Keys

# Backend secret key (starts with sk_test_ or sk_live_)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend publishable key (starts with pk_test_ or pk_live_)
# Note: Also needed in apps/web/.env.local as NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret
# Get from: Clerk Dashboard > Webhooks > Your Endpoint > Signing Secret
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# MUX Video (for video streaming)
# =============================================================================
# Get these from: https://dashboard.mux.com/ > Settings > Access Tokens
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# =============================================================================
# Payment Providers
# =============================================================================

# Stripe (International)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paystack (Nigeria, Ghana, South Africa, Kenya)
# Get from: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Flutterwave (Pan-African)
# Get from: https://dashboard.flutterwave.com/dashboard/settings/apis
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# =============================================================================
# Cloud Storage (choose one)
# =============================================================================

# Option 1: AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# Option 2: Cloudinary
CLOUDINARY_URL=

# Option 3: Vercel Blob
BLOB_READ_WRITE_TOKEN=

# =============================================================================
# LLM Integration (for content analysis)
# =============================================================================

# Option 1: OpenAI
OPENAI_API_KEY=

# Option 2: Anthropic
ANTHROPIC_API_KEY=

# =============================================================================
# Application Settings
# =============================================================================
NODE_ENV=development
PORT=3001
